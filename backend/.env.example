# MailFlow Backend Environment Configuration
DEBUG=True
SECRET_KEY=mailflow-insecure-dev-secret-key-change-in-production-2025!@#
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (leave blank for default SQLite in development)
# DATABASE_URL=postgresql://mailflow:password@localhost:5432/mailflow_db

# Email Service Mode
# Set EMAIL_DEV_MODE=True to safely record emails locally without external SMTP
EMAIL_DEV_MODE=True

# Real SMTP Configuration (used when EMAIL_DEV_MODE=False)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Real IMAP Configuration (used for inbox synchronization)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=True
